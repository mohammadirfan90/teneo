# ──────────────────────────────────────────────────────────────────────
# Housing & Roommate Platform — Backend environment
# Copy to .env (gitignored) and fill in real values for local dev.
# Production values come from Render env groups; never commit .env.
# ──────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (Prisma 7 uses driver adapters; the @prisma/adapter-pg driver
# reads this URL directly. Add ?pgbouncer=true&connection_limit=1 when
# pointing at Neon serverless to avoid the "too many connections" trap.)
DATABASE_URL=postgresql://housing:housing@localhost:5432/housing?schema=public

# Redis (used for access-token store, rate-limit buckets, idempotency,
# webhook replay protection, hot caches).
REDIS_URL=redis://localhost:6379

# Token secrets (rotate in prod). Use 32+ random bytes base64url.
ACCESS_TOKEN_SECRET=dev-only-change-me-in-prod-please-use-openssl-rand-base64-32
REFRESH_TOKEN_SECRET=dev-only-change-me-in-prod-please-use-openssl-rand-base64-32

# Stripe (test mode for development — get keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google OAuth (optional — endpoint returns 503 if unset; demo can skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound (for password-reset / verify-email links in later phases)
APP_PUBLIC_URL=http://localhost:3000

# Cloudinary object storage — room photos (public CDN) and KYC/lease
# documents (private, signed 15-minute URLs).
# Credentials: https://console.cloudinary.com → Dashboard → API Keys.
# Optional in dev: upload routes return 503 STORAGE_DISABLED when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder namespacing every asset, so one account can host dev/prod.
CLOUDINARY_FOLDER=teneo
