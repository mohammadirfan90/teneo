// prisma/schema.prisma
// Phase 3: identity + KYC + audit entities.
// Authoritative source: housing-platform/04-database-design.md §4.3.1, §4.3.7, §4.3.8
//                     + housing-platform/02-users-and-roles.md §2.2.
//
// Prisma 7 specifics (see phase 2):
//   - generator provider is "prisma-client" (not "prisma-client-js")
//   - `output` is REQUIRED — clients no longer land in node_modules
//   - `previewFeatures = ["driverAdapters"]` is required to use
//     @prisma/adapter-pg (or any non-Rust driver)
//   - The datasource `url` field is NO LONGER supported in schema.prisma.
//     Connection URL is read from prisma.config.ts (datasource.url) and the
//     PrismaClient constructor receives an `adapter` (which @prisma/adapter-pg
//     is, backed by the `pg` driver).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────────────
// Extensions (Phase 3 migration adds them).
//
//   citext — case-insensitive text, used for users.email so we don't need
//            LOWER() in every lookup and so the unique constraint is
//            naturally case-insensitive.
//   pgcrypto — gen_random_uuid() so we can default-id PKs without a round
//              trip through the app.
// ──────────────────────────────────────────────────────────────────────
// (Extensions are created via a custom SQL migration; see
//  prisma/migrations/<ts>_init_identity/migration.sql.)

// ──────────────────────────────────────────────────────────────────────
// Enums (per spec)
// ──────────────────────────────────────────────────────────────────────

/// User account status (04 §4.3.1).
enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Roles a user can hold (02 §2.2).
/// Primary roles gate application access; supporting roles (USER, GUEST,
/// SYSTEM) are never persisted in user_roles — they are derived from the
/// authenticated session (USER, GUEST) or issued via service credentials
/// (SYSTEM). ADMIN is provisioned out-of-band and lives here.
enum Role {
  TENANT
  OWNER
  ADMIN
}

/// Self-declared gender used by roommate matching (02 §2.2 last paragraph,
/// 04 §4.3.1). Optional — UNDISCLOSED is implicit when null.
enum Gender {
  FEMALE
  MALE
  NONBINARY
  UNDISCLOSED
}

/// KYC lifecycle per role (04 §4.3.1).
enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// KYC submission lifecycle (04 §4.3.8).
enum KycSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ──────────────────────────────────────────────────────────────────────
// Phase 10: property hierarchy + publish state machine enums
// ──────────────────────────────────────────────────────────────────────

/// Lifecycle of a Property (04 §4.3.2).
enum PropertyStatus {
  DRAFT
  PUBLISHED
  TAKEN_DOWN
}

/// What shape the property has (04 §4.3.2).
enum PropertyType {
  BUILDING
  VILLA
  STANDALONE_FLAT
}

/// Lifecycle of a Building node in the property hierarchy. v1 only
/// uses ACTIVE / ARCHIVED — soft-delete lives on the parent property.
enum BuildingStatus {
  ACTIVE
  ARCHIVED
}

/// Lifecycle of a Flat node. Same shape as Building.
enum FlatStatus {
  ACTIVE
  ARCHIVED
}

/// Room type per spec §4.3.2.
enum RoomType {
  PRIVATE
  SHARED
  STUDIO
  ENTIRE_FLAT
}

/// Room state machine per spec §5.4.
enum RoomStatus {
  DRAFT
  PUBLISHED
  RESERVED
  OCCUPIED
  MAINTENANCE_CHECK
  MAINTENANCE
  TAKEN_DOWN
}

// ──────────────────────────────────────────────────────────────────────
// Identity & Profiles (04 §4.3.1)
// ──────────────────────────────────────────────────────────────────────

/// Auth identity + profile root. One row per human (and per SYSTEM service
/// account). Tenant ID scaffolding (04 §4.1.8) lives on every table for v2
/// multi-tenancy; v1 writes a single constant.
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @db.Citext
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phone           String?
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  passwordHash    String?    @map("password_hash")
  oauthProvider   String?    @map("oauth_provider")
  oauthSubject    String?    @map("oauth_subject")
  status          UserStatus @default(ACTIVE)
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  mfaSecret       String?    @map("mfa_secret")
  gender          Gender?
  tenantId        String     @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  roles                  UserRole[]
  ownerProfile           OwnerProfile?
  tenantProfile          TenantProfile?
  tenantPreferences      PreferencesTenant?
  kycSubmissions         KycSubmission[]
  refreshTokens          RefreshToken[]
  properties             Property[]
  savedSearches          SavedSearch[]
  applications           Application[]
  viewingRequests        ViewingRequest[]
  leaseTenancies         LeaseTenant[]
  leaseSignatures        LeaseSignature[]
  leaseAmendments        LeaseAmendment[]
  rentInvoicesDisputed   RentInvoice[]           @relation("RentInvoiceDisputedBy")
  rentInvoicesWaived     RentInvoice[]           @relation("RentInvoiceWaivedBy")
  paymentsMade           Payment[]               @relation("PaymentTenant")
  meterReadings          MeterReading[]          @relation("MeterReadingSubmitter")
  billShares             BillShare[]             @relation("BillShareTenant")
  ticketsRaised          MaintenanceTicket[]     @relation("TicketRaiser")
  ticketsResolved        MaintenanceTicket[]     @relation("TicketResolver")
  ticketsClosed          MaintenanceTicket[]     @relation("TicketCloser")
  ticketUpdates          MaintenanceUpdate[]     @relation("UpdateAuthor")
  documents              Document[]
  roomPhotos             RoomPhoto[]
  matchResultsCaller     MatchResult[]           @relation("MatchCaller")
  matchResultsCandidate  MatchResult[]           @relation("MatchCandidate")
  introsAsCaller         IntroRequest[]          @relation("IntroCaller")
  introsAsCandidate      IntroRequest[]          @relation("IntroCandidate")

  // Partial unique indexes live in the migration SQL:
  //   users(email) WHERE deleted_at IS NULL            → users_email_active_uniq
  //   users(oauth_provider, oauth_subject) WHERE oauth_provider IS NOT NULL
  //                                                  → users_oauth_uniq
  @@index([status, deletedAt], name: "users_status_idx")
  @@map("users")
}

/// User → role binding. A user can hold multiple roles (e.g. both TENANT
/// and OWNER). ADMIN is provisioned out-of-band per 02 §2.2.
model UserRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz(6)
  tenantId    String   @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role], name: "user_roles_user_role_uniq")
  @@index([role], name: "user_roles_role_idx")
  @@map("user_roles")
}

/// 1:1 with User — owner role-profile (04 §4.3.1).
model OwnerProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  displayName       String    @map("display_name")
  bio               String?
  avatarObjectKey   String?   @map("avatar_object_key")
  kycStatus         KycStatus @default(NONE) @map("kyc_status")
  kycBadgeGrantedAt DateTime? @map("kyc_badge_granted_at") @db.Timestamptz(6)
  reputationScore   Decimal?  @map("reputation_score") @db.Decimal(4, 2)
  tenantId          String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("owner_profiles")
}

/// 1:1 with User — tenant role-profile (04 §4.3.1).
/// Roommate preferences (budget, lifestyle, visibility) live in a separate
/// `preferences_tenant` table per §4.3.3 — to be added in phase 20.
model TenantProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  displayName       String    @map("display_name")
  bio               String?
  avatarObjectKey   String?   @map("avatar_object_key")
  kycStatus         KycStatus @default(NONE) @map("kyc_status")
  kycBadgeGrantedAt DateTime? @map("kyc_badge_granted_at") @db.Timestamptz(6)
  reputationScore   Decimal?  @map("reputation_score") @db.Decimal(4, 2)
  tenantId          String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

// ──────────────────────────────────────────────────────────────────────
// KYC (04 §4.3.8)
// ──────────────────────────────────────────────────────────────────────

/// A single KYC submission attempt for a (user, role) tuple. Partial unique
/// index (user_id, role) WHERE status IN ('PENDING','APPROVED') enforces
/// "at most one active submission per (user, role)" — added via the
/// custom migration SQL because Prisma doesn't yet express partial
/// indexes natively.
model KycSubmission {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  role               Role
  status             KycSubmissionStatus @default(PENDING)
  documentObjectKeys String[]            @map("document_object_keys")
  reviewNotes        String?             @map("review_notes")
  reviewerUserId     String?             @map("reviewer_user_id") @db.Uuid
  decidedAt          DateTime?           @map("decided_at") @db.Timestamptz(6)
  expiresAt          DateTime?           @map("expires_at") @db.Timestamptz(6)
  docHash            String?             @map("doc_hash")
  /// Cross-user docHash collision flag — set when another user already
  /// submitted with the same hash. Surfaces to admins in the queue.
  flaggedForReview   Boolean             @default(false) @map("flagged_for_review")
  tenantId           String              @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, status], name: "kyc_submissions_lookup_idx")
  @@index([docHash], name: "kyc_submissions_doc_hash_idx")
  // Partial unique index added in migration SQL:
  //   CREATE UNIQUE INDEX kyc_submissions_active_uniq
  //   ON kyc_submissions (user_id, role)
  //   WHERE status IN ('PENDING','APPROVED');
  @@map("kyc_submissions")
}

// ──────────────────────────────────────────────────────────────────────
// Audit (04 §4.3.7)
// ──────────────────────────────────────────────────────────────────────

/// Append-only audit trail for every privileged action. The immutability
/// trigger that blocks UPDATE/DELETE outside the retention job is added
/// via the custom migration SQL.
model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  actorRole        String?  @map("actor_role")
  action           String
  targetEntityType String?  @map("target_entity_type")
  targetEntityId   String?  @map("target_entity_id") @db.Uuid
  before           Json?
  after            Json?
  ipAddress        String?  @map("ip_address") @db.Inet
  userAgent        String?  @map("user_agent")
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  tenantId         String   @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid

  @@index([actorUserId, occurredAt(sort: Desc)], name: "audit_logs_actor_idx")
  @@index([targetEntityType, targetEntityId], name: "audit_logs_target_idx")
  @@index([action, occurredAt], name: "audit_logs_action_idx")
  // Monthly partitioning by occurred_at — added in migration SQL.
  @@map("audit_logs")
}

// ──────────────────────────────────────────────────────────────────────
// Refresh tokens (06 §6.4)
// ──────────────────────────────────────────────────────────────────────

/// Hashed refresh tokens. The token row id is `sha256(raw_token)` (hex, 64
/// chars) so we never store the secret in cleartext and can look up by id
/// without a secondary index.
model RefreshToken {
  id        String    @id
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")
  ip        String?   @db.Inet
  tenantId  String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "refresh_tokens_user_idx")
  @@index([familyId], name: "refresh_tokens_family_idx")
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────────────────
// Tenant preferences (Phase 8, 04 §4.3.3)
// ──────────────────────────────────────────────────────────────────────

/// What a tenant is *looking for*, distinct from their identity
/// profile. Visibility controls whether other tenants / owners can
/// see this sheet for matching.
model PreferencesTenant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  budgetMinMinor  BigInt?   @map("budget_min_minor")
  budgetMaxMinor  BigInt?   @map("budget_max_minor")
  preferredCities String[]  @map("preferred_cities")
  moveInFrom      DateTime? @map("move_in_from") @db.Date
  moveInTo        DateTime? @map("move_in_to") @db.Date
  lifestyle       Json?
  interests       String[]
  visibility      String    @default("PRIVATE")
  tenantId        String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // GIN(lifestyle) + GIN(preferred_cities) live in the migration SQL
  // because Prisma doesn't yet express GIN indexes natively.
  @@map("preferences_tenant")
}


// ──────────────────────────────────────────────────────────────────────
// Phase 10: property hierarchy + publish state machine (04 §4.3.2,
// 05 §5.4, 13 §13.2.3)
// ──────────────────────────────────────────────────────────────────────

/// A property is the top of the owner-published hierarchy. It is the
/// unit of address / geo and the unit of publication (POST /publish
/// cascades to all draft rooms). Soft-deleted with `deletedAt` so the
/// audit trail and history are preserved.
model Property {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId  String         @map("owner_user_id") @db.Uuid
  title        String
  description  String?
  addressLine1 String         @map("address_line1")
  addressLine2 String?        @map("address_line2")
  city         String
  area         String?
  postalCode   String?        @map("postal_code")
  /// ISO 3166-1 alpha-2 (e.g. "US", "GB", "BD").
  countryCode  String         @map("country_code") @db.Char(2)
  latitude     Decimal?       @db.Decimal(9, 6)
  longitude    Decimal?       @db.Decimal(9, 6)
  propertyType PropertyType   @map("property_type")
  status       PropertyStatus @default(DRAFT)
  publishedAt  DateTime?      @map("published_at") @db.Timestamptz(6)
  /// Optimistic concurrency for property-level state changes (per §5.6).
  version      Int            @default(0)
  tenantId     String         @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft-delete; cascades to buildings → flats → rooms by convention
  /// (we never hard-delete these in v1).
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  owner     User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  buildings Building[]
  rooms     Room[]
  meters    PropertyMeter[]

  // Indexes per §4.3.2 — full SQL (incl. composite city/status/published_at
  // and geo index) lives in the migration since Prisma can't express them
  // exactly as the spec wants.
  @@index([ownerUserId], name: "properties_owner_idx")
  @@index([status, deletedAt], name: "properties_status_idx")
  @@map("properties")
}

/// Optional intermediate node between Property and Flat — used for
/// BUILDING and VILLA property types. Cascade from property.
model Building {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String         @map("property_id") @db.Uuid
  name       String
  floors     Int?
  status     BuildingStatus @default(ACTIVE)
  tenantId   String         @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?      @map("deleted_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  flats    Flat[]

  @@index([propertyId], name: "buildings_property_idx")
  @@map("buildings")
}

/// A flat within a building (or a standalone flat for STANDALONE_FLAT
/// property type — in that case `building` is null and `propertyId` is
/// reached through Room.propertyId). Cascade from building.
model Flat {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId String     @map("building_id") @db.Uuid
  floor      Int?
  doorNumber String?    @map("door_number")
  status     FlatStatus @default(ACTIVE)
  tenantId   String     @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@index([buildingId], name: "flats_building_idx")
  @@map("flats")
}

/// The most-queried entity in the hierarchy. Carries the publish state
/// machine (05 §5.4). `propertyId` is denormalized from flat → building
/// → property to keep the spec's `INDEX(property_id)` query path fast
/// (and to allow `STANDALONE_FLAT` rooms that have no Flat).
/// `flatId` is nullable: rooms can outlive their flat (ON DELETE SET NULL)
/// or live without one (standalone villa).
model Room {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId     String     @map("property_id") @db.Uuid
  flatId         String?    @map("flat_id") @db.Uuid
  label          String
  roomType       RoomType   @map("room_type")
  sizeSqft       Decimal?   @map("size_sqft") @db.Decimal(8, 2)
  maxOccupants   Int        @default(1) @map("max_occupants")
  /// Monthly base rent, minor units (cents). BigInt to avoid float drift.
  baseRentMinor  BigInt     @map("base_rent_minor")
  /// Refundable deposit at lease signing, minor units (cents).
  depositMinor   BigInt     @map("deposit_minor")
  /// ISO 4217 currency code (e.g. "USD", "EUR", "BDT"). Stored as CHAR(3).
  currency       String     @db.Char(3)
  billsIncluded  Boolean    @default(false) @map("bills_included")
  amenities      String[]
  /// Room state machine (05 §5.4).
  status         RoomStatus @default(DRAFT)
  availableFrom  DateTime?  @map("available_from") @db.Date
  minLeaseMonths Int?       @map("min_lease_months")
  maxLeaseMonths Int?       @map("max_lease_months")
  /// Free-text house rules. The structured `room_rules` table is
  /// deferred to Phase 20 (matching).
  rules          String?
  /// Optimistic-concurrency version (05 §6 — every state transition
  /// increments this; UPDATE WHERE version=? guards against lost
  /// updates).
  version        Int        @default(0)
  tenantId       String     @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)

  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  flat            Flat?               @relation(fields: [flatId], references: [id], onDelete: SetNull)
  applications    Application[]
  viewingRequests ViewingRequest[]
  tickets         MaintenanceTicket[]
  photos          RoomPhoto[]

  // Full index set (incl. status/available_from, GIN(amenities)) lives in
  // the migration SQL since Prisma can't express composite/partial/GIN
  // indexes natively.
  @@index([propertyId], name: "rooms_property_idx")
  @@index([flatId], name: "rooms_flat_idx")
  @@index([status, deletedAt], name: "rooms_status_idx")
  @@index([currency], name: "rooms_currency_idx")
  @@map("rooms")
}

/// User-saved search query (13 §13.2.4). Persists a named filter set so
/// tenants can return to a previous filter state without re-entering it.
/// Refresh-on-new-match is deferred to Phase 18 (notifications); Phase
/// 11 only persists the search.
model SavedSearch {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// User-chosen label. Uniqueness enforced per active user via the
  /// partial unique index in the migration SQL.
  name      String
  /// Full filter shape — same shape as `searchRoomsQuerySchema`'s parsed
  /// output. Storing as JSONB lets us round-trip it without re-encoding.
  query     Json
  tenantId  String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "saved_searches_user_idx")
  @@map("saved_searches")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 10: property hierarchy relations update (rooms/applications/viewings)
// ──────────────────────────────────────────────────────────────────────

// ──────────────────────────────────────────────────────────────────────
// Phase 12: Applications + ViewingRequests + ApplicationNotes enums (13
// §13.2.5, 04 §4.3.4, 05 §5.5)
// ──────────────────────────────────────────────────────────────────────

/// Application lifecycle (05 §5.5).
enum ApplicationStatus {
  SUBMITTED
  SCREENING
  VIEWING_SCHEDULED
  SHORTLISTED
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLED
}

/// Viewing request lifecycle.
enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Lease lifecycle (Phase 13 will own the API surface; Phase 12 ships the
/// schema stub only — the APPROVED transition does NOT create a row in
/// Phase 12).
enum LeaseStatus {
  DRAFT
  SIGNED
  ACTIVE
  ENDED
  TERMINATED
}

/// How rent + utilities are split across co-tenants (04 §4.3.4).
enum UtilitySplitMode {
  EQUAL
  PROPORTIONAL
  CUSTOM
}

/// Role a signer played when signing a lease (Phase 13).
enum LeasePartyRole {
  OWNER
  TENANT
}

/// Lifecycle of a lease amendment proposal (Phase 13 stub).
enum LeaseAmendmentStatus {
  PROPOSED
  SIGNED
  REJECTED
}

/// Lifecycle of a rent invoice per spec §5.2.
///   DUE              — newly generated, awaiting payment
///   PARTIALLY_PAID   — some but not all of totalMinor has been paid
///   PAID             — totalMinor <= amountPaidMinor (terminal in Phase 14;
///                      Phase 15 webhooks will populate)
///   OVERDUE          — past due_date and not yet settled
///   WAIVED           — ADMIN cleared the balance (terminal)
///   DISPUTED         — tenant or owner flagged a concern; admin resolves
enum InvoiceStatus {
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  DISPUTED
}

// ──────────────────────────────────────────────────────────────────────
// Phase 12: Application model (04 §4.3.4, 05 §5.5)
// ──────────────────────────────────────────────────────────────────────

/// A tenant's application for a room. Lifecycle is governed by
/// `applications.state-machine.ts` (Phase 12). The partial unique
/// index `(room_id, tenant_user_id) WHERE status IN (...)` enforces
/// "at most one active application per (room, tenant)" — see migration
/// SQL.
model Application {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String            @map("room_id") @db.Uuid
  tenantUserId    String            @map("tenant_user_id") @db.Uuid
  message         String?
  status          ApplicationStatus @default(SUBMITTED)
  submittedAt     DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(6)
  decidedByUserId String?           @map("decided_by_user_id") @db.Uuid
  /// Optimistic-concurrency version (05 §5.6). Every transition
  /// increments this; UPDATE WHERE version=? guards against lost
  /// updates from concurrent owner clicks.
  version         Int               @default(0)
  tenantId        String            @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  room     Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant   User              @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  viewings ViewingRequest[]

  // Prisma-tracked indexes; the critical partial UNIQUE on active
  // applications lives in the migration SQL.
  @@index([roomId, status], name: "applications_room_status_idx")
  @@index([tenantUserId, status], name: "applications_tenant_status_idx")
  @@index([decidedByUserId], name: "applications_decided_by_idx")
  @@map("applications")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 12: ViewingRequest model (04 §4.3.4)
// ──────────────────────────────────────────────────────────────────────

/// A viewing proposed by the room owner. The owner creates the row
/// with one or more `proposedSlots[]`; tenant (or owner) later picks
/// one to set `confirmedSlot`. Cancel by either party.
model ViewingRequest {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String?       @map("application_id") @db.Uuid
  roomId        String        @map("room_id") @db.Uuid
  tenantUserId  String        @map("tenant_user_id") @db.Uuid
  proposedSlots DateTime[]    @map("proposed_slots") @db.Timestamptz(6)
  confirmedSlot DateTime?     @map("confirmed_slot") @db.Timestamptz(6)
  status        ViewingStatus @default(REQUESTED)
  /// Optional human-readable reason (cancellation, etc.).
  reason        String?
  tenantId      String        @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenant      User         @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([roomId, status], name: "viewing_requests_room_status_idx")
  @@index([tenantUserId, status], name: "viewing_requests_tenant_status_idx")
  @@map("viewing_requests")
}


// ──────────────────────────────────────────────────────────────────────
// Phase 12: Lease stub (Phase 13 owns the API surface; schema only here)
// ──────────────────────────────────────────────────────────────────────

/// Lease contract between a tenant and an owner for a specific room.
/// Phase 12 shipped the schema stub; Phase 13 inserts the DRAFT row
/// inside the APPROVED application's `$transaction` and exposes the
/// full multi-party signing / activation / termination lifecycle.
///
/// Tenancy (multi-tenant scoping) lives on `LeaseTenant` rows +
/// co-tenant rows; the relational truth never depended on a `Lease`
/// `tenantId` placeholder. Phase 14 drops that placeholder column.
///
/// Rent invoices (`rent_invoices`) hang off a lease; `utilityShareMinor`
/// is populated by Phase 16's meter + bill-split pipeline.
model Lease {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId                     String           @map("room_id") @db.Uuid
  ownerUserId                String           @map("owner_user_id") @db.Uuid
  primaryTenantUserId        String           @map("primary_tenant_user_id") @db.Uuid
  startDate                  DateTime         @map("start_date") @db.Date
  endDate                    DateTime         @map("end_date") @db.Date
  rentMinor                  BigInt           @map("rent_minor")
  depositMinor               BigInt           @map("deposit_minor")
  currency                   String           @db.Char(3)
  lateFeePolicy              Json?            @map("late_fee_policy")
  utilitySplitMode           UtilitySplitMode @default(EQUAL) @map("utility_split_mode")
  /// CUSTOM-mode percentages per tenant. JSONB array of
  /// `{ tenantUserId: string, percent: number }` summing to 100.00.
  /// Required when utility_split_mode = 'CUSTOM'; ignored otherwise.
  /// Phase 16 reads it for splitCustom; Phase 18+ will add a writer route.
  utilitySplitCustomPercents Json?            @map("utility_split_custom_percents")
  status                     LeaseStatus      @default(DRAFT)
  signedAt                   DateTime?        @map("signed_at") @db.Timestamptz(6)
  activatedAt                DateTime?        @map("activated_at") @db.Timestamptz(6)
  endedAt                    DateTime?        @map("ended_at") @db.Timestamptz(6)
  contractObjectKey          String?          @map("contract_object_key")
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenants      LeaseTenant[]
  signatures   LeaseSignature[]
  amendments   LeaseAmendment[]
  rentInvoices RentInvoice[]
  payments     Payment[]
  utilityBills UtilityBill[]
  tickets      MaintenanceTicket[]

  @@index([roomId, status], name: "leases_room_status_idx")
  @@index([ownerUserId, status], name: "leases_owner_status_idx")
  @@map("leases")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 13: LeaseTenant (co-tenants per spec 04 §4.3.4)
// ──────────────────────────────────────────────────────────────────────

/// One tenant's stake in a lease. Composite PK matches the spec exactly.
/// `is_primary` uniqueness is enforced as a PARTIAL UNIQUE index in the
/// migration SQL (Prisma can't model partial uniques natively).
model LeaseTenant {
  leaseId        String   @map("lease_id") @db.Uuid
  tenantUserId   String   @map("tenant_user_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  liabilityShare Decimal  @map("liability_share") @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lease  Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant User  @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@id([leaseId, tenantUserId])
  @@unique([leaseId, isPrimary], name: "lease_tenants_one_primary_per_lease")
  @@index([tenantUserId], name: "lease_tenants_tenant_idx")
  @@map("lease_tenants")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 13: LeaseSignature (multi-party signing tracker)
// ──────────────────────────────────────────────────────────────────────

/// One row per (lease, signer). `UNIQUE(lease_id, signer_user_id)`
/// gives free idempotency — the second `POST /sign` from the same
/// party no-ops (caught at the service layer via the unique lookup).
/// `signer_role` is denormalized at sign-time so audit-log readers
/// don't need to join to `lease_tenants` to know who signed as
/// TENANT vs OWNER.
model LeaseSignature {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId      String         @map("lease_id") @db.Uuid
  signerUserId String         @map("signer_user_id") @db.Uuid
  signerRole   LeasePartyRole @map("signer_role")
  signedAt     DateTime       @default(now()) @map("signed_at") @db.Timestamptz(6)
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")

  lease  Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  signer User  @relation(fields: [signerUserId], references: [id], onDelete: Cascade)

  @@unique([leaseId, signerUserId], name: "lease_signatures_lease_signer_uq")
  @@index([leaseId], name: "lease_signatures_lease_idx")
  @@map("lease_signatures")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 13: LeaseAmendment (stub for /amend + /amendments/:aid/sign)
// ──────────────────────────────────────────────────────────────────────

/// A proposed amendment to a lease (rent change, end-date change,
/// terms). Phase 13 only stores a JSON `payload` — Phase 14+ defines
/// the real shape per spec.
model LeaseAmendment {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId          String               @map("lease_id") @db.Uuid
  proposedByUserId String               @map("proposed_by_user_id") @db.Uuid
  status           LeaseAmendmentStatus @default(PROPOSED)
  payload          Json                 @map("payload")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  signedAt         DateTime?            @map("signed_at") @db.Timestamptz(6)

  lease      Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  proposedBy User  @relation(fields: [proposedByUserId], references: [id], onDelete: Cascade)

  @@index([leaseId], name: "lease_amendments_lease_idx")
  @@map("lease_amendments")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 14: RentInvoice + InvoiceStatus enum (13 §13.2.6, 05 §5.2,
// 04 §4.3.4, 03 §3.4)
// ──────────────────────────────────────────────────────────────────────

/// One rent invoice per (lease, periodStart). UNIQUE(lease_id,
/// period_start) at the migration SQL is the source of truth for
/// idempotency — POST /bills/generate with the same (lease, periodStart)
/// is a no-op and returns the existing row.
///
/// Phase 14 stores `utilityShareMinor = 0` always; Phase 16 will fill
/// it from meter readings + bill-splitter.
///
/// `tenantId` is forward-compat scaffolding — Phase 14 writes a single
/// constant for v1 single-tenancy (matches the convention used on every
/// other table). It is NOT the relational truth for tenancy (that lives
/// in `lease_tenants`); it is purely a v2 multi-tenancy placeholder.
///
/// The dispute flag is inlined (disputed_at / disputed_by_user_id /
/// dispute_reason) rather than split into a separate table because the
/// state machine holds at most one open dispute per invoice.
model RentInvoice {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId           String        @map("lease_id") @db.Uuid
  /// First day of the billing period (UTC date).
  periodStart       DateTime      @map("period_start") @db.Date
  /// Last day of the billing period (UTC date).
  periodEnd         DateTime      @map("period_end") @db.Date
  baseRentMinor     BigInt        @map("base_rent_minor")
  utilityShareMinor BigInt        @default(0) @map("utility_share_minor")
  lateFeeMinor      BigInt        @default(0) @map("late_fee_minor")
  totalMinor        BigInt        @map("total_minor")
  amountPaidMinor   BigInt        @default(0) @map("amount_paid_minor")
  currency          String        @db.Char(3)
  status            InvoiceStatus @default(DUE)
  dueDate           DateTime      @map("due_date") @db.Date
  version           Int           @default(0)
  generatedAt       DateTime      @default(now()) @map("generated_at") @db.Timestamptz(6)
  disputedAt        DateTime?     @map("disputed_at") @db.Timestamptz(6)
  disputedByUserId  String?       @map("disputed_by_user_id") @db.Uuid
  disputeReason     String?       @map("dispute_reason")
  waivedAt          DateTime?     @map("waived_at") @db.Timestamptz(6)
  waivedByUserId    String?       @map("waived_by_user_id") @db.Uuid
  waiveReason       String?       @map("waive_reason")
  /// Forward-compat: always '00000000-0000-0000-0000-000000000000' in v1.
  /// Not the relational truth for tenancy (lease_tenants is).
  tenantId          String        @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  lease          Lease     @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  disputedByUser User?     @relation("RentInvoiceDisputedBy", fields: [disputedByUserId], references: [id], onDelete: SetNull)
  waivedByUser   User?     @relation("RentInvoiceWaivedBy", fields: [waivedByUserId], references: [id], onDelete: SetNull)
  payments       Payment[]

  // The UNIQUE(lease_id, period_start) constraint is added via the
  // custom migration SQL (Prisma could express it via @@unique, but
  // matching the existing hand-edited convention used by lease_tenants
  // / leases_end_date_active_idx keeps the migration readable).
  @@index([leaseId, status], name: "rent_invoices_lease_status_idx")
  @@index([status, dueDate], name: "rent_invoices_status_due_idx")
  @@index([status, generatedAt], name: "rent_invoices_status_generated_idx")
  @@map("rent_invoices")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 15: Payment + PaymentGateway/PaymentStatus enums (07 §7.4,
// 13 §13.2.7, 04 §4.3.6)
//
// One row per Stripe PaymentIntent attempt. Lifecycle:
//   PROCESSING — intent created, awaiting webhook
//   SUCCEEDED  — webhook confirmed capture; invoice.amount_paid += amount
//   FAILED     — webhook reported failure
//   REFUNDED   — ADMIN called POST /refund, charge.refunded webhook arrived
//
// Full refund only in v1; PARTIALLY_REFUNDED is deferred to Phase 18+.
//
// Idempotency layers:
//   1. idempotency_key (TRUE UNIQUE) — caller-driven, the response is
//      cached for 24h via withIdempotency middleware AND the DB enforces
//      uniqueness on retry.
//   2. (gateway, gateway_payment_intent_id) PARTIAL UNIQUE WHERE NOT NULL
//      — DB-level race protection for webhook duplicates of Stripe.
//   3. Redis SET NX EX 86400 stripe:webhook:seen:{event.id} — webhook-
//      level dedup.
//
// lease_id is denormalized from rent_invoices.lease_id so the hot path
// in /payments/me can index-scan payments by tenant without joining
// rent_invoices. ON DELETE RESTRICT on all FKs preserves the audit trail.
// ──────────────────────────────────────────────────────────────────────

/// Gateway that processed the payment. v1 has STRIPE only; the enum
/// keeps the door open for Phase 18+ (Razorpay, Adyen, etc.).
enum PaymentGateway {
  STRIPE
}

/// Payment row lifecycle.
enum PaymentStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  /// Intent abandoned or cancelled before capture (Stripe
  /// `payment_intent.canceled`). Distinct from FAILED: no charge was
  /// attempted and declined, so the invoice stays DUE and payable.
  CANCELED
  REFUNDED
}

model Payment {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId              String         @map("invoice_id") @db.Uuid
  /// Denormalized from rent_invoices.lease_id for hot-path lookups on
  /// /payments/me without joining rent_invoices.
  leaseId                String         @map("lease_id") @db.Uuid
  /// Tenant who initiated the payment. Required (every payment has a
  /// human payer — service-account payments are not in scope).
  tenantUserId           String         @map("tenant_user_id") @db.Uuid
  gateway                PaymentGateway @default(STRIPE)
  /// `pi_xxx` from Stripe. Nullable because the row is INSERTed with
  /// a placeholder, then UPDATEd after the Stripe API call returns the
  /// real PaymentIntent id (rare race; mostly pre-populated via
  /// `prisma.payment.create` with the id returned by the SDK).
  gatewayPaymentIntentId String?        @map("gateway_payment_intent_id")
  /// `ch_xxx` from `payment_intent.succeeded.latest_charge`. Nullable:
  /// only set after a successful capture.
  gatewayChargeId        String?        @map("gateway_charge_id")
  /// `re_xxx` from `charge.refunded.data.object.refunds.data[*].id`.
  /// Nullable: only set after a refund event.
  gatewayRefundId        String?        @map("gateway_refund_id")
  /// Authorized/captured amount in cents. For v1, must equal the
  /// invoice's total_minor — partial payments via Stripe are deferred.
  amountMinor            BigInt         @map("amount_minor")
  /// Cumulative refunded amount in cents. For FULL refund, equals
  /// amountMinor. Rolled up by the webhook handler.
  refundedAmountMinor    BigInt         @default(0) @map("refunded_amount_minor")
  /// ISO 4217 currency code (e.g. "USD", "EUR", "BDT"). Denormalized
  /// from rent_invoices.currency so we can serve /payments/me without
  /// joining.
  currency               String         @db.Char(3)
  status                 PaymentStatus  @default(PROCESSING)
  /// Caller-supplied. UNIQUE — the response is cached for 24h via
  /// withIdempotency AND the DB enforces uniqueness on retry. Both
  /// layers are belt-and-braces: withIdempotency saves the Stripe API
  /// call, the UNIQUE saves the DB write.
  idempotencyKey         String         @map("idempotency_key")
  /// From `payment_intent.payment_failed.last_payment_error.code`
  /// (e.g. "card_declined"). Nullable.
  failureCode            String?        @map("failure_code")
  /// From `payment_intent.payment_failed.last_payment_error.message`.
  /// Truncated to 500 chars in the webhook handler.
  failureReason          String?        @map("failure_reason")
  paidAt                 DateTime?      @map("paid_at") @db.Timestamptz(6)
  failedAt               DateTime?      @map("failed_at") @db.Timestamptz(6)
  refundedAt             DateTime?      @map("refunded_at") @db.Timestamptz(6)
  canceledAt             DateTime?      @map("canceled_at") @db.Timestamptz(6)
  /// Stripe's `cancellation_reason` (e.g. "abandoned",
  /// "requested_by_customer", "automatic"). Null for any other status.
  cancellationReason     String?        @map("cancellation_reason")
  /// Optimistic-concurrency version. Incremented on every UPDATE so
  /// concurrent webhook deliveries + intent races don't clobber.
  version                Int            @default(0)
  /// Forward-compat v2 multi-tenancy scaffold (always
  /// '00000000-0000-0000-0000-000000000000' in v1).
  tenantId               String         @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice RentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lease   Lease       @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenant  User        @relation("PaymentTenant", fields: [tenantUserId], references: [id], onDelete: Restrict)

  // UNIQUE constraints (hand-edited in the migration SQL because Prisma
  // doesn't model partial uniques):
  //   payments_idempotency_key_uq             — TRUE UNIQUE(idempotency_key)
  //   payments_gateway_intent_uq              — PARTIAL UNIQUE(gateway,
  //                                            gateway_payment_intent_id)
  //                                            WHERE gateway_payment_intent_id
  //                                            IS NOT NULL
  //   payments_gateway_charge_idx             — partial non-unique index on
  //                                            gateway_charge_id WHERE NOT NULL
  //                                            (charge.refunded looks up by
  //                                            charge_id first)
  @@index([invoiceId, status], name: "payments_invoice_status_idx")
  @@index([tenantUserId, createdAt(sort: Desc)], name: "payments_tenant_idx")
  @@index([status, createdAt], name: "payments_status_idx")
  @@map("payments")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 16: Utility meters + readings + bills + bill-shares
// (13 §13.2.6, 05 §5.3, 04 §4.3.5)
//
// Property-level meters (e.g., building water, electricity) carry:
//   - utility_type (which kind of meter)
//   - rate_per_unit_minor + unit_label (pricing snapshot at install time)
//
// MeterReading rows are append-only with UNIQUE(meter_id, reading_date) —
// a second reading for the same date is rejected at the DB level. Phase
// 18+ will add reading-correction flows.
//
// UtilityBill rows are created by /bills/generate and are tied to
// (lease, meter, period). They carry a snapshot of the previous and
// current readings so the bill is self-contained for audit + replay.
//
// BillShare rows split the UtilityBill.total_amount_minor across
// co-tenants per lease.utility_split_mode. Σ share_minor ==
// bill.total_amount_minor EXACTLY (largest-remainder rounding invariant
// — see bill-splitter.ts and verify-p16-splitter.ts).
//
// utility_share_minor on rent_invoices is the sum of BillShare.shareMinor
// for the invoice's lease tenants. It is recomputed by /bills/generate.
// ──────────────────────────────────────────────────────────────────────

/// Categories of utilities tracked by a PropertyMeter (05 §5.3).
enum UtilityType {
  WATER
  ELECTRICITY
  GAS
  INTERNET
}

/// A meter attached to a Property. Phase 16 only models per-property
/// meters (e.g., building main water). Per-room sub-meters are deferred
/// to Phase 18+ (which will introduce a `roomId` nullable field).
model PropertyMeter {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId       String      @map("property_id") @db.Uuid
  utilityType      UtilityType @map("utility_type")
  /// Human label, e.g., "Main water meter", "Sub-meter #3".
  label            String
  /// Per-unit price snapshot. E.g., 350n = $3.50/m³. Phase 18+ will
  /// replace this with a utility_rates table for rate history.
  ratePerUnitMinor BigInt      @map("rate_per_unit_minor")
  currency         String      @db.Char(3)
  /// Display unit string: "m³", "kWh", "GB", etc. Free-text — informs
  /// the meter-reading UI without forcing a per-utility enum.
  unitLabel        String      @map("unit_label")
  /// Lifecycle: v1 sets once to true; deactivation is Phase 18+.
  isActive         Boolean     @default(true) @map("is_active")
  tenantId         String      @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  readings MeterReading[]
  bills    UtilityBill[]

  // Hand-edited in migration SQL: no partial uniques here (meters don't
  // need them — UNIQUE is reserved for hand-edited UNIQUE on
  // meter_readings(meter_id, reading_date) below).
  @@index([propertyId, isActive], name: "meters_property_active_idx")
  @@index([propertyId, utilityType], name: "meters_property_type_idx")
  @@map("property_meters")
}

/// One reading for one meter on one date. Append-only.
/// UNIQUE(meter_id, reading_date) at the migration SQL rejects duplicate
/// readings for the same date (re-submission must use a different date
/// or correct via the Phase 18+ correction flow).
model MeterReading {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meterId           String   @map("meter_id") @db.Uuid
  /// UTC date. UNIQUE per (meterId, readingDate).
  readingDate       DateTime @map("reading_date") @db.Date
  /// Meter reading value. Decimal(12, 4) handles fractional smart-meter
  /// readings (e.g., 12345.6789 kWh). Phase 18+ may widen to (18, 6).
  readingValue      Decimal  @map("reading_value") @db.Decimal(12, 4)
  /// Optional notes (e.g., "estimated — meter inaccessible").
  notes             String?
  /// User who submitted the reading. OWNER or a tenant on an active
  /// lease for the meter's property.
  submittedByUserId String   @map("submitted_by_user_id") @db.Uuid
  tenantId          String   @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  meter     PropertyMeter @relation(fields: [meterId], references: [id], onDelete: Restrict)
  submitter User          @relation("MeterReadingSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@index([meterId, readingDate(sort: Desc)], name: "readings_meter_date_idx")
  @@map("meter_readings")
}

/// One utility bill per (lease, meter, period). Created by
/// /bills/generate. The previous/current readings are snapshotted at
/// generation time so the bill is self-contained for audit + replay.
///
/// `superseded` flips to true when a regenerate with new readings
/// produces a new bill for the same (lease, period, meter); the old
/// row stays around for audit but is excluded from sum-to-invoice.
model UtilityBill {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseId              String    @map("lease_id") @db.Uuid
  meterId              String    @map("meter_id") @db.Uuid
  periodStart          DateTime  @map("period_start") @db.Date
  periodEnd            DateTime  @map("period_end") @db.Date
  /// Reading snapshot at periodStart (or the meter baseline if no
  /// earlier reading exists).
  previousReadingValue Decimal   @map("previous_reading_value") @db.Decimal(12, 4)
  /// Reading snapshot at periodEnd.
  currentReadingValue  Decimal   @map("current_reading_value") @db.Decimal(12, 4)
  /// Computed: current - previous. Decimal to match the reading
  /// precision.
  consumptionUnits     Decimal   @map("consumption_units") @db.Decimal(12, 4)
  /// Computed: round(consumption × rate_per_unit_minor) — BigInt cents.
  totalAmountMinor     BigInt    @map("total_amount_minor")
  currency             String    @db.Char(3)
  /// Bill generation timestamp.
  generatedAt          DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  /// Soft-delete: false = contributes to rent_invoice.utility_share_minor.
  /// Set true when a new UtilityBill for the same (lease, period, meter)
  /// supersedes this one.
  superseded           Boolean   @default(false)
  supersededAt         DateTime? @map("superseded_at") @db.Timestamptz(6)
  tenantId             String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid

  lease  Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  meter  PropertyMeter @relation(fields: [meterId], references: [id], onDelete: Restrict)
  shares BillShare[]

  @@index([leaseId, periodStart], name: "utility_bills_lease_period_idx")
  @@index([meterId, periodStart], name: "utility_bills_meter_period_idx")
  @@map("utility_bills")
}

/// One tenant's share of a UtilityBill. Σ share_minor per bill ==
/// bill.total_amount_minor EXACTLY (largest-remainder rounding).
///
/// `splitMode` is a snapshot of lease.utility_split_mode at generation
/// time, so future changes to the lease don't retroactively alter bills.
///
/// `weightUsed` snapshots the liabilityShare (Decimal(5,2)) used as the
/// weight for PROPORTIONAL split. Null for EQUAL and CUSTOM.
model BillShare {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId       String   @map("bill_id") @db.Uuid
  tenantUserId String   @map("tenant_user_id") @db.Uuid
  shareMinor   BigInt   @map("share_minor")
  splitMode    String   @map("split_mode") @db.VarChar(16)
  weightUsed   Decimal? @map("weight_used") @db.Decimal(5, 2)
  tenantId     String   @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bill   UtilityBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  tenant User        @relation("BillShareTenant", fields: [tenantUserId], references: [id], onDelete: Restrict)

  @@index([billId], name: "bill_shares_bill_idx")
  @@index([tenantUserId, createdAt(sort: Desc)], name: "bill_shares_tenant_idx")
  @@map("bill_shares")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 17: Maintenance tickets + update thread (11 §11.5, 04 §4.6).
//
// MaintenanceTicket is raised by a tenant on an ACTIVE lease (or one
// that ended <= 7 days ago, per spec 11 §11.5.5). The room → property
// → lease → tenants chain back-resolves the owner for triage.
//
// Lifecycle (05 §5.7):
//   OPEN          → ACKNOWLEDGED, CANCELLED        (owner / tenant)
//   ACKNOWLEDGED  → IN_PROGRESS, CANCELLED, DISPUTED
//   IN_PROGRESS   → RESOLVED, DISPUTED
//   RESOLVED      → CLOSED, DISPUTED
//   DISPUTED      → RESOLVED                        (ADMIN only)
//   CLOSED        → terminal
//   CANCELLED     → terminal
//
// SLA policy (per priority, raised_date + slaHours):
//   LOW      168h   (7d)
//   MEDIUM    72h   (3d)
//   HIGH      24h   (1d)
//   URGENT     4h
//
// `sla_breached_at` is set lazily inside `transitionTicket` when a
// transition happens after sla_target_at while the ticket is still
// open (NOT yet CLOSED/CANCELLED). It is null while within SLA.
//
// `rating` (1..5) is set by the raiser once the ticket is RESOLVED.
// One rating per ticket — resubmitting returns 409 CONFLICT.
//
// `lease_id` is a SNAPSHOT — the ticket remains authoritative even if
// the lease ends, is terminated, or is amended. The cascade behavior
// is Restrict on lease so the audit trail is preserved.
// ──────────────────────────────────────────────────────────────────────

/// Maintenance issue category (04 §4.6).
enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  APPLIANCE
  HVAC
  STRUCTURAL
  PEST
  OTHER
}

/// SLA priority bucket. SLA_HOURS_BY_PRIORITY lives in
/// tickets.state-machine.ts and is the single source of truth.
enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Ticket lifecycle. Mirrors the state machine in
/// tickets.state-machine.ts.
enum MaintenanceStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
  /// Tenant disputes an owner's resolution; an ADMIN resolves it.
  DISPUTED
}

model MaintenanceTicket {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId            String              @map("room_id") @db.Uuid
  /// Snapshot at raise-time so the ticket remains authoritative even
  /// if the lease ends/terminates/amends.
  leaseId           String              @map("lease_id") @db.Uuid
  raisedByUserId    String              @map("raised_by_user_id") @db.Uuid
  title             String
  description       String
  category          MaintenanceCategory
  priority          MaintenancePriority @default(MEDIUM)
  status            MaintenanceStatus   @default(OPEN)
  /// Computed at raise-time: now() + slaHoursFor(priority).
  slaTargetAt       DateTime            @map("sla_target_at") @db.Timestamptz(6)
  /// Set the first time a transition happens after sla_target_at while
  /// the ticket is still open (not CLOSED/CANCELLED). Null while within
  /// SLA.
  slaBreachedAt     DateTime?           @map("sla_breached_at") @db.Timestamptz(6)
  /// Set on transition into RESOLVED.
  resolvedAt        DateTime?           @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId  String?             @map("resolved_by_user_id") @db.Uuid
  /// Set on transition into CLOSED.
  closedAt          DateTime?           @map("closed_at") @db.Timestamptz(6)
  closedByUserId    String?             @map("closed_by_user_id") @db.Uuid
  /// Tenant satisfaction rating (1..5). Set only after RESOLVED.
  rating            Int?
  ratingComment     String?             @map("rating_comment")
  ratingSubmittedAt DateTime?           @map("rating_submitted_at") @db.Timestamptz(6)
  /// Forward-compat v2 multi-tenancy placeholder. Always the constant
  /// zero-uuid in v1.
  tenantId          String              @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  room       Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  lease      Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  raisedBy   User                @relation("TicketRaiser", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  resolvedBy User?               @relation("TicketResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  closedBy   User?               @relation("TicketCloser", fields: [closedByUserId], references: [id], onDelete: Restrict)
  updates    MaintenanceUpdate[]

  // CHECK (rating BETWEEN 1 AND 5) lives in the migration SQL.
  @@index([roomId, status], name: "tickets_room_status_idx")
  @@index([status, slaTargetAt], name: "tickets_sla_watch_idx")
  @@index([raisedByUserId, createdAt(sort: Desc)], name: "tickets_raiser_idx")
  @@map("maintenance_tickets")
}

/// Comment thread on a ticket. Append-only.
///
/// `statusAfter` is a snapshot of the post-call status when a single
/// call both adds an update AND transitions the ticket (e.g., the
/// /dispute convenience endpoint). Null for pure-comment inserts.
model MaintenanceUpdate {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String             @map("ticket_id") @db.Uuid
  authorUserId String             @map("author_user_id") @db.Uuid
  body         String
  statusAfter  MaintenanceStatus? @map("status_after")
  tenantId     String             @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User              @relation("UpdateAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Asc)], name: "maintenance_updates_ticket_idx")
  @@map("maintenance_updates")
}

// ──────────────────────────────────────────────────────────────────────
// Phase 18: Notifications + Documents (04 §4.3.7, 05 §5.8, 13 §13.2.8)
//
// Notification rows back the in-app feed. Phases 9-17 already write
// outbox_events rows for ≈30 distinct event types — Phase 18 ships
// the receiver + a synchronous emit() helper that other modules can
// call from inside their prisma.$transaction. Phase 19+ replaces the
// in-tx model with an outbox-relay dispatcher and wires real EMAIL
// delivery.
//
// Notification.eventType uses a closed-set enum so the TypeScript
// type system catches typos at every call site. The map keys stored in
// NotificationPreference.channelEventMap are FREE-FORM strings —
// clients can opt into new event types added in Phase 19+ without
// breaking serialization.
//
// Document rows are the new home for everything that previously held
// a bare objectKey string (KYC submissions, leases, room photos,
// maintenance ticket attachments). Phase 18 ships presigned-URL stubs
// (`https://stub.local/...` URLs that expire in 15 minutes); Phase 19+
// replaces them with real S3 / Cloudflare R2 signed URLs.
//
// Both tables cascade-delete with the owning user so soft-delete or
// PII anonymization in Phase 8 cleans them up automatically.
// ──────────────────────────────────────────────────────────────────────

/// Owned storage object — a single source of truth for private files
/// (KYC documents, lease contracts, maintenance ticket attachments).
///
/// Backed by Cloudinary with `type: authenticated`, so the bytes are
/// never publicly addressable: GET /documents/:id/url mints a signed
/// URL that expires after 15 minutes. Public listing images are a
/// different concern and live in `RoomPhoto` instead.
model Document {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String  @map("owner_user_id") @db.Uuid
  /// Cloudinary `public_id` (e.g. `teneo/documents/{userId}/{uuid}`).
  /// Kept under the historical `object_key` column name so existing
  /// rows and indexes survive the switch from the stub storage layer.
  objectKey   String  @map("object_key")
  contentType String  @map("content_type")
  /// Actual byte size reported by Cloudinary after the upload lands.
  sizeBytes   BigInt  @map("size_bytes")
  /// Free-text label (e.g., "Passport scan", "Lease contract").
  label       String?
  /// Lifecycle: ACTIVE | SOFT_DELETED. DELETE flips the flag, stamps
  /// deletedAt, and destroys the remote asset.
  status      String  @default("ACTIVE") @db.VarChar(16)

  /// Storage backend that owns the asset. Recorded per-row so a future
  /// migration to another provider can run incrementally.
  storageProvider String  @default("cloudinary") @map("storage_provider") @db.VarChar(24)
  /// Cloudinary resource_type — `image` or `raw` (PDFs land in `raw`).
  /// Required to address the asset on delivery and destroy.
  resourceType    String  @default("image") @map("resource_type") @db.VarChar(16)
  /// Cloudinary delivery type. Documents are always `authenticated`
  /// (private); the download route mints a short-lived signed URL.
  deliveryType    String  @default("authenticated") @map("delivery_type") @db.VarChar(16)
  /// Cloudinary content hash, used to detect a re-upload of identical bytes.
  etag            String? @db.VarChar(64)

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status], name: "documents_owner_status_idx")
  @@index([objectKey], name: "documents_object_key_idx")
  @@map("documents")
}

/// Room listing photos stored in Cloudinary (public `upload` delivery —
/// these are marketing images on a published listing, fetched by
/// anonymous browsers, so they carry no signature).
///
/// `position` drives gallery order. It is deliberately NOT uniquely
/// constrained per room: reordering rewrites several rows inside one
/// transaction, and a unique index would need to be DEFERRABLE to allow
/// the intermediate states. Ordering is normalised in service code.
model RoomPhoto {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId           String @map("room_id") @db.Uuid
  uploadedByUserId String @map("uploaded_by_user_id") @db.Uuid

  /// Cloudinary `public_id` (e.g. `teneo/rooms/{roomId}/{uuid}`).
  publicId        String  @map("public_id")
  /// Fully-qualified https CDN URL, denormalised so list responses do
  /// not have to rebuild it per row.
  secureUrl       String  @map("secure_url")
  storageProvider String  @default("cloudinary") @map("storage_provider") @db.VarChar(24)
  resourceType    String  @default("image") @map("resource_type") @db.VarChar(16)
  deliveryType    String  @default("upload") @map("delivery_type") @db.VarChar(16)
  contentType     String  @map("content_type")
  sizeBytes       BigInt  @map("size_bytes")
  width           Int?
  height          Int?
  etag            String? @db.VarChar(64)
  /// Zero-based gallery position; 0 is the listing cover image.
  position        Int     @default(0)
  /// Accessibility text shown when the image cannot be rendered.
  alt             String?

  tenantId  String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  room       Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([roomId, position], name: "room_photos_room_position_idx")
  @@index([publicId], name: "room_photos_public_id_idx")
  @@map("room_photos")
}


// ──────────────────────────────────────────────────────────────────────
// Phase 20: Roommate matching (13 §13.2.4, 05 §5.1)
// ──────────────────────────────────────────────────────────────────────

/// One row per (caller, candidate) pair produced by `POST /match/run`.
/// Re-running match for the same caller deletes prior rows and inserts
/// fresh ones in a single transaction; the latest results are what
/// `GET /match/results` returns.
model MatchResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The tenant who ran the match.
  callerUserId    String   @map("caller_user_id") @db.Uuid
  /// The candidate tenant that was ranked.
  candidateUserId String   @map("candidate_user_id") @db.Uuid
  /// Composite score in [0, 100]. Pre-penalty base (from breakDown)
  /// can theoretically exceed 100 — clamps happen in scoring.ts.
  score           Int
  /// Per-dimension points so the caller can see why a candidate
  /// scored what they did.
  breakdown       Json
  /// Human-readable explanation of the score and any hard penalties
  /// applied (e.g., "Hard penalty: gender mismatch"). Multi-line.
  explain         String
  rank            Int      @map("rank")
  tenantId        String   @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  caller    User          @relation("MatchCaller", fields: [callerUserId], references: [id], onDelete: Cascade)
  candidate User          @relation("MatchCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  intro     IntroRequest?

  @@unique([callerUserId, candidateUserId], name: "match_results_caller_candidate_uq")
  @@index([callerUserId, rank(sort: Asc)], name: "match_results_caller_rank_idx")
  @@map("match_results")
}

/// Mutual-introduction request lifecycle. Caller opens an intro for
/// one of their MatchResult rows; the candidate accepts; on the
/// SECOND accept (mutual) the contact info is revealed (Phase 20
/// ships the row model; reveal is a separate field populated when
/// both sides have accepted).
model IntroRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchResultId       String    @map("match_result_id") @db.Uuid
  callerUserId        String    @map("caller_user_id") @db.Uuid
  candidateUserId     String    @map("candidate_user_id") @db.Uuid
  callerAcceptedAt    DateTime? @map("caller_accepted_at") @db.Timestamptz(6)
  candidateAcceptedAt DateTime? @map("candidate_accepted_at") @db.Timestamptz(6)
  /// Set to now() when both sides have accepted. Until then the row
  /// is in 'PENDING' and contact info is hidden from both parties.
  revealedAt          DateTime? @map("revealed_at") @db.Timestamptz(6)
  declinedAt          DateTime? @map("declined_at") @db.Timestamptz(6)
  tenantId            String    @default("00000000-0000-0000-0000-000000000000") @map("tenant_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  matchResult MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  caller      User        @relation("IntroCaller", fields: [callerUserId], references: [id], onDelete: Cascade)
  candidate   User        @relation("IntroCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([matchResultId], name: "intro_requests_match_uq")
  @@index([callerUserId, createdAt(sort: Desc)], name: "intro_requests_caller_idx")
  @@index([candidateUserId, createdAt(sort: Desc)], name: "intro_requests_candidate_idx")
  @@map("intro_requests")
}
